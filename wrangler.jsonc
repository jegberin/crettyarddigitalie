{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crettyarddigitalie",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker before the asset handler for every request so it can
    // attach RFC 8288 Link headers and serve markdown alternates via Accept
    // negotiation. Normal asset serving is delegated to env.ASSETS.fetch.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },

  // Markdown-for-Agents cache. The scheduled handler renders each route via
  // Cloudflare Browser Rendering's /markdown endpoint and writes the result
  // here; the fetch handler reads from this when Accept: text/markdown matches.
  "kv_namespaces": [
    {
      "binding": "MARKDOWN_CACHE",
      "id": "83bac33b4b584ee6b0826fe300cb747f"
    }
  ],

  // Daily refresh at 04:10 UTC (low traffic). Free Browser Rendering quota is
  // 10 min/day; ~30 routes × ~3 s = ~1.5 min/day plus 10 s spacing between
  // calls to stay under the 1-request-per-10-s rate limit.
  "triggers": {
    "crons": ["10 4 * * *"]
  }
}
