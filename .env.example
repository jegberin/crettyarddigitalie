# Resend API key for sending form emails (https://resend.com)
RESEND_API_KEY=

# From address used for outbound email.
# Must be on a domain you've verified in Resend.
# Falls back to onboarding@resend.dev (sandbox) if unset.
RESEND_SENDER=quoterequest@digital.crettyard.ie

# Server port (docker-compose maps host 3000 → container 3000)
PORT=3000
